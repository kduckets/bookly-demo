# Required. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Main agent model (default: claude-opus-5-5) and its effort level (low | medium | high; default: low).
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Cheap model for the scope pre-check (default: claude-haiku-5-5).
ANTHROPIC_PRECHECK_MODEL=claude-haiku-5-5

# Optional switches
# BOOKLY_PRECHECK=heuristic   # skip the pre-check model call and use regex heuristics only
# BOOKLY_FALLBACKS=off        # disable server-side refusal fallbacks

# Open Library asks API users to identify themselves. Optional: a contact email added to the User-Agent.
# OPEN_LIBRARY_CONTACT_EMAIL=
